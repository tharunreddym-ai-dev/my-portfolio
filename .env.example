# ==============================================================================
# Tharun Reddy M - Personal Portfolio & Systems Environment Variables
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in the keys below as you obtain them.
# 3. For Vercel deployment: Add these same variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GROQ API KEYS (Fallback Chain Tier 1)
# Sign up at: https://console.groq.com/keys
# Groq provides ultra-fast, free tier inference for Llama models.
# You can generate up to 3 keys across accounts for automatic fallback rotation.
# ------------------------------------------------------------------------------
GROQ_API_KEY_1=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""

# ------------------------------------------------------------------------------
# 2. GEMINI API KEYS (Fallback Chain Tier 2)
# Sign up at: https://aistudio.google.com/app/apikey
# Google provides generous free tier rate limits.
# ------------------------------------------------------------------------------
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# ------------------------------------------------------------------------------
# 3. ALLOWED_ORIGIN (Optional — locks /api/chat and /api/contact to your own site)
# Leave blank and nothing changes. Once your site has a stable URL (a .vercel.app
# domain or your own custom domain), set this to it — e.g.
#   ALLOWED_ORIGIN="https://tharunreddy.vercel.app"
# This makes it harder for another website's script to call your API endpoints
# directly using your Groq/Gemini/Telegram/Brevo keys. It's a soft check (a
# request with no Origin header is still allowed through, to avoid false blocks),
# but it closes off the easiest form of casual abuse.
# ------------------------------------------------------------------------------
ALLOWED_ORIGIN=""

# ------------------------------------------------------------------------------
# 4. TELEGRAM NOTIFICATIONS (Instant Lead Alerts)
# Step-by-step:
# a) Open Telegram, search for "@BotFather", send "/newbot" to create a bot.
#    BotFather will give you a token like: 7123456789:AAH...
# b) Search for your bot on Telegram and tap "Start" so it can message you.
# c) Find your Chat ID by messaging "@userinfobot" on Telegram (it returns an ID like: 123456789).
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# 5. BREVO EMAIL (Automated Confirmation Email to Visitors)
# Sign up free at: https://www.brevo.com/ (300 free emails/day)
# Step-by-step:
# a) Brevo -> SMTP & API (or "API Keys & MCP") -> API Keys -> Generate a new API key.
#    It MUST start with "xkeysib-". The SMTP key ("xsmtpsib-") will NOT work here.
# b) Verify your sender email in Brevo -> Senders, Domains & Dedicated IPs -> Senders.
# c) Brevo -> Settings -> Security -> Authorised IPs -> turn OFF IP blocking.
#    (Vercel's server IPs change, so Brevo blocks them unless this is off.)
# d) Paste the key into Vercel WITHOUT quotes, then Redeploy.
# If the email still fails, your Telegram alert will show the exact reason.
# ------------------------------------------------------------------------------
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="tharunreddymofficialg@gmail.com"
BREVO_SENDER_NAME="Tharun Reddy M"
